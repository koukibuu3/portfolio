{
  "name": "portfolio",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:content && next build",
    "start": "next start",
    "lint": "eslint src scripts tests *.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "sync:writing": "tsx scripts/sync-writing.ts",
    "export:legacy": "tsx scripts/export-legacy.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "lint-staged": "lint-staged",
    "prepare": "husky install",
    "check:routes": "tsx scripts/check-routes.ts"
  },
  "dependencies": {
    "feed": "4.2.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rss-parser": "3.13.0",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.0.0",
    "husky": "8.0.3",
    "lint-staged": "17.6.0",
    "prettier": "3.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint",
      "prettier --check"
    ]
  },
  "engines": {
    "node": ">=24.18.1"
  }
}
